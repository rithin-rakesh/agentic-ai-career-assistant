# ==============================================================================
# ENVIRONMENT CONFIGURATION MATRIX — AGENTIC AI CAREER ASSISTANT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT SETTINGS
# ------------------------------------------------------------------------------
# Active environment environment tag (development, production, testing)
ENVIRONMENT=development

# Base URL for Web Dashboard and direct email links
APP_BASE_URL=http://localhost:8000

# Developer Toggle for Web Collection
# Set to True to use simulated/mock jobs to bypass anti-bot blocks
# Set to False to perform live HTTP scraping (RemoteOK, Arbeitnow, Remotive)
MOCK_COLLECTOR=True

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# Database Connection URL (SQLite default for local dev, PostgreSQL for production)
# Development SQLite: sqlite:///data/jobs.db
# Production PostgreSQL: postgresql://jobuser:your_secure_password@postgres:5432/jobdb
DATABASE_URL=sqlite:///data/jobs.db

# PostgreSQL Credentials (Used by Docker Compose in production)
POSTGRES_USER=jobuser
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=jobdb

# ------------------------------------------------------------------------------
# 3. REDIS & TASK QUEUE CONFIGURATION
# ------------------------------------------------------------------------------
# Redis Connection URL for Celery worker queues and caching
# Local Dev: redis://localhost:6379/0
# Docker Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Celery Task Queue Toggle (Set True for Celery background workers, False for Async background thread)
USE_CELERY=False

# ------------------------------------------------------------------------------
# 4. QDRANT VECTOR DATABASE & RAG CONFIGURATION
# ------------------------------------------------------------------------------
# Qdrant Vector DB Connection URL (:memory: for local pytest, http://qdrant:6333 for Docker)
VECTOR_DB_URL=:memory:

# Target vector collection name for candidate resume embeddings
COLLECTION_NAME=resume_chunks

# Local Embedding Model for RAG vector similarity search
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 5. GEMINI & LLM GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Fallback OpenAI API Key (Optional)
OPENAI_API_KEY=

# Primary AI Model Identifier (gemini-2.5-flash, gemini-1.5-pro, gpt-4o-mini, gpt-4o)
MODEL_NAME=gemini-2.5-flash

# Model Hyperparameters
MAX_TOKENS=2048
TEMPERATURE=0.2
REQUEST_TIMEOUT=30

# Developer Toggle for LLM Client (Set True for local offline mock evaluations, False for Live API)
MOCK_LLM=True

# ------------------------------------------------------------------------------
# 6. GMAIL & SMTP EMAIL NOTIFICATION CONFIGURATION
# ------------------------------------------------------------------------------
# SMTP Server Host (e.g. smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# SMTP Server Port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# Sender Gmail Address
SMTP_USERNAME=your_email@gmail.com

# 16-character Gmail App Password (https://myaccount.google.com/apppasswords)
SMTP_PASSWORD=your_16_char_app_password

# Recipient email address for daily reports and instant job alerts
NOTIFICATION_EMAIL=your_email@gmail.com

# Minimum Match Score percentage to trigger instant high-priority email alerts (0-100)
INSTANT_THRESHOLD=85

# ------------------------------------------------------------------------------
# 7. SCHEDULER & PIPELINE CONFIGURATION
# ------------------------------------------------------------------------------
# Periodic job collection & evaluation interval in hours (1, 2, 4, 6, 12, 24)
COLLECTION_INTERVAL_HOURS=4

# Candidate Resume Storage Path (Supports .pdf, .md, .txt)
RESUME_PATH=data/resume.md

# ------------------------------------------------------------------------------
# 8. LOGGING & TRACING
# ------------------------------------------------------------------------------
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log output format (text, json)
LOG_FORMAT=text

# Optional Sentry DSN for error tracking
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 9. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# JWT Secret Key for dashboard session signatures (generate with `openssl rand -hex 32`)
SECRET_KEY=change_this_to_a_random_secret_key_in_production

# JWT Access Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Dashboard Default Login Credentials
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=admin

# ------------------------------------------------------------------------------
# 10. MONITORING & OBSERVABILITY
# ------------------------------------------------------------------------------
# Grafana Admin Password
GF_SECURITY_ADMIN_PASSWORD=change_this_grafana_admin_password

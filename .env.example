# SQLite Database Configuration
DATABASE_URL=sqlite:///data/jobs.db

# Developer Toggle for Web Collection
# Set to True to use simulated/mock jobs to bypass Cloudflare/scraping blocks
# Set to False to perform live requests scraping from Wellfound (subject to anti-bot blocks)
MOCK_COLLECTOR=True

# Log Configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Day 3 AI Agent Configuration
# Paste your OpenAI API key here to enable live LLM reasoning evaluations.
# If left empty, the application automatically triggers local simulation/mock evaluations.
OPENAI_API_KEY=

# LLM Model Details
MODEL_NAME=gpt-4o-mini
MAX_TOKENS=1000
TEMPERATURE=0.2
REQUEST_TIMEOUT=30

# Developer Toggle for LLM Client
# Set to True to run local simulations without hitting OpenAI endpoint (no credits consumed)
# Set to False to execute real API queries (requires valid OPENAI_API_KEY)
MOCK_LLM=True

# Path to Candidate Resume (Supports .md, .txt, or .pdf files)
# If the file is missing, the application automatically builds a template resume for you on boot.
RESUME_PATH=data/resume.md

# Scheduling configuration (Day 2)
COLLECTION_INTERVAL_HOURS=4
